{
  "name": "agentdraw-canvas",
  "version": "2.0.0",
  "description": "AI-ready canvas library on Konva.js — 40+ shapes, 20 animations, agentic spatial API, pan/zoom, dark/light themes.",
  "main": "src/CanvasStudio.js",
  "type": "module",
  "scripts": {
    "dev": "npx serve . -p 3000",
    "build": "npx esbuild src/CanvasStudio.js --bundle --outfile=dist/agentdraw-canvas.bundle.js --format=esm",
    "lint": "npx eslint src/**/*.js"
  },
  "keywords": [
    "canvas",
    "konva",
    "drawing",
    "whiteboard",
    "diagram",
    "animation",
    "shapes",
    "drag-drop",
    "pan-zoom",
    "ai canvas",
    "agent canvas",
    "agentic AI",
    "LLM canvas",
    "spatial reasoning",
    "multimodal agent",
    "AI whiteboard",
    "educational canvas",
    "interactive diagram",
    "atoms",
    "physics diagram",
    "chemistry canvas",
    "dark theme",
    "open source"
  ],
  "files": [
    "dist",
    "src",
    "styles",
    "index.html",
    "README.md",
    "LICENSE"
  ],
  "author": "Mehul Ligade <mehulcode12@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/mehulcode12/agentdraw-canvas.git"
  },
  "peerDependencies": {
    "konva": "^9.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.20.0",
    "eslint": "^8.0.0",
    "serve": "^14.0.0"
  }
}